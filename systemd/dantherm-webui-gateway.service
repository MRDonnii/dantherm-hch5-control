[Unit]
Description=Dantherm HCH5 PassiveLink controller gateway and WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=passivelink-webui
Group=passivelink-webui
SupplementaryGroups=dialout video
WorkingDirectory=/opt/dantherm-passivelink-webui
EnvironmentFile=/etc/dantherm-passivelink-webui/gateway.env
UMask=0027
ExecStartPre=/bin/sh -c 'test -e "$RS485_DEVICE"'
# Persistent runtime state is prepared explicitly before privilege drop. Do not
# put /var/lib/dantherm-hch5-ha behind an additional systemd mount namespace:
# older Pi/systemd combinations have made the otherwise writable state path
# unavailable to SQLite/auth while the same path worked from the host shell.
ExecStartPre=+/usr/bin/install -d -o passivelink-webui -g passivelink-webui -m 0750 /var/lib/dantherm-hch5-ha
ExecStartPre=+/bin/chown -R passivelink-webui:passivelink-webui /var/lib/dantherm-hch5-ha
ExecStartPre=/bin/sh -c 'test -w /var/lib/dantherm-hch5-ha'
ExecStartPre=/bin/sh -c 'test ! -e /var/lib/dantherm-hch5-ha/webui-auth.json || test -r /var/lib/dantherm-hch5-ha/webui-auth.json'
ExecStartPre=/bin/sh -c 'test ! -e /var/lib/dantherm-hch5-ha/history.sqlite3 || test -w /var/lib/dantherm-hch5-ha/history.sqlite3'
ExecStart=/usr/bin/env DANTHERM_WEBUI_AUTH_FILE=/var/lib/dantherm-hch5-ha/webui-auth.json /opt/dantherm-passivelink-webui/venv/bin/python /opt/dantherm-passivelink-webui/dantherm_controller_gateway.py -c /etc/dantherm-passivelink-webui/controller.yaml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
